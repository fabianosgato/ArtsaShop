{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "vue-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "resources/js/frontend/*"
            ],
            "@components/*": [
                "resources/js/frontend/components/*"
            ],
            "@pages/*": [
                "resources/js/frontend/pages/*"
            ],
            "@layouts/*": [
                "resources/js/frontend/layouts/*"
            ]
        },
        "types": [
            "vite/client",
            "vue",
            "@inertiajs/vue3"
        ]
    },
    "include": [
        "resources/js/**/*",
        "vite.config.js"
    ],
    "exclude": [
        "node_modules",
        "vendor"
    ]
}
